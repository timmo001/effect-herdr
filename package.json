{
  "name": "@timmo001/effect-herdr",
  "version": "0.9.0-timmo001.0",
  "description": "Effect-native TypeScript SDK for Herdr's local socket API.",
  "homepage": "https://github.com/timmo001/effect-herdr#readme",
  "bugs": {
    "url": "https://github.com/timmo001/effect-herdr/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/effect-herdr.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": [
        "./dist/index.d.ts",
        "./src/index.ts"
      ],
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "check": "bun run --parallel --no-exit-on-error lint typecheck format:check test",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "node scripts/generate-wire-types.mjs && prettier --write src/generated",
    "example": "bun run build && node --experimental-strip-types",
    "prepare": "effect-tsgo patch --force=false",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.0.2",
    "ajv": "8.20.0",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@oxlint/plugins": "1.87.0",
    "@timmo001/oxlint-rules": "0.6.2",
    "@types/node": "26.6.4",
    "json-schema-to-typescript": "16.0.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@effect/tsgo"
  ],
  "herdr": {
    "protocol": 22,
    "upstreamCommit": "48292af8e33a08c8030b7f1512c8d0da739f5ab1"
  }
}
